+  // IMPORTANT: these are read via `process.env.*` in server-only code
+  // (never in a client component), so they're deliberately NOT prefixed
+  // with NEXT_PUBLIC_ — that prefix makes Next.js freeze the value into
+  // the bundle at build time, and since the build for this adapter runs
+  // locally (not on Cloudflare), the value would freeze as "undefined"
+  // unless it's also set in your local .env. Keep the same values in
+  // both places (wrangler.jsonc "vars" for the deployed Worker, and a
+  // local .env for `next build`/`next dev`) whenever you change them.
+  "vars": {
+    "SITE_URL": "https://draculasoil.com",
+    "R2_PUBLIC_URL": "https://pub-f1cc3576e6ed47a79e95137a90a5747c.r2.dev"
