# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local dev image upload fallback (production uses Vercel Blob instead)
/public/uploads

# vercel
.vercel

# cloudflare / opennext
.open-next/
.wrangler/
cloudflare-env.d.ts
.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma 7 generated client (regenerated by `prisma generate` / postinstall)
/lib/generated/

.vercel
.env*
