{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "draculas-soil",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Static assets produced by the OpenNext build (JS/CSS chunks, images, etc.)
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Lets the worker call itself for internal routes (required by OpenNext).
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "draculas-soil" }
  ],

  // Two R2 buckets:
  //  - NEXT_INC_CACHE_R2_BUCKET: OpenNext's ISR/data cache (opaque, managed by the adapter)
  //  - PRODUCT_IMAGES: where uploaded product photos live (replaces Vercel Blob)
  // Create both with:
  //   npx wrangler r2 bucket create draculas-soil-cache
  //   npx wrangler r2 bucket create draculas-soil-images
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "draculas-soil-cache" },
    { "binding": "PRODUCT_IMAGES", "bucket_name": "draculas-soil-images" }
  ],

  // Cloudflare Images binding — used to resize/convert uploads to webp
  // instead of `sharp` (which can't run on the Workers runtime).
  "images": {
    "binding": "IMAGES"
  }
}
